NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# E-mail (SMTP Hostinger)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contato@aluguelcuiaba.com.br
SMTP_PASS=

RESEND_API_KEY=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_WHATSAPP_DEFAULT=
CRON_SECRET=

# Stripe (pagamentos)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASICO=
STRIPE_PRICE_PROFISSIONAL=

# Seguros — Maximiza (fiança)
# Credencial ÚNICA da plataforma: e-mail/senha, não API key. O corretor
# nunca vê. O token dura ~7 dias e é cacheado em memória.
MAXIMIZA_EMAIL=
MAXIMIZA_SENHA=
# 2 = homologação · 1 = PRODUÇÃO (emite apólice de verdade).
# A API usa a mesma URL nos dois — o que separa é este número. Sem a var,
# o código falha de propósito em vez de assumir.
MAXIMIZA_AMBIENTE=2
# Segredo no path dos webhooks (/api/webhooks/maximiza/<segredo>/...).
# A Maximiza não assina os webhooks; isso é a primeira camada de defesa.
MAXIMIZA_WEBHOOK_SEGREDO=
# CNPJ de imobiliária liberado pela Maximiza para testes. Só é usado quando
# MAXIMIZA_AMBIENTE=2 — em produção cada corretor responde pelo próprio
# CNPJ, e uma apólice emitida sob o CNPJ de teste sairia no nome errado.
MAXIMIZA_CNPJ_TESTE=
# Demonstração enquanto a credencial não chega: troca APENAS a chamada
# HTTP por um simulador. Mapper, persistência e telas continuam sendo o
# código real, então o caminho já fica exercitado. Recusa rodar com
# MAXIMIZA_AMBIENTE=1 — simulação em produção geraria apólice falsa.
# O último dígito do CPF escolhe o cenário: 9 recusa, 8 biometria,
# 7 limite inferior, 6 em análise, demais aprovam.
MAXIMIZA_DEMO=
